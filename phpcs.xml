<?xml version="1.0"?>
<ruleset name="CHIP for Fluent Forms">
	<description>PHPCS ruleset for CHIP for Fluent Forms plugin.</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Only scan PHP files -->
	<arg name="extensions" value="php"/>

	<!-- Exclude paths -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/ci-build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<!-- Use WordPress coding standards -->
	<rule ref="WordPress">
	</rule>

	<!-- Set minimum supported PHP version -->
	<config name="minimum_supported_wp_version" value="6.1"/>
	<config name="testVersion" value="7.4-8.5"/>

	<!-- Text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="chip-for-fluent-forms"/>
			</property>
		</properties>
	</rule>

	<!-- Main plugin entry point cannot be renamed to class-chip-fluent-forms.php. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>chip-for-fluent-forms.php</exclude-pattern>
		<exclude-pattern>uninstall.php</exclude-pattern>
	</rule>

	<!-- WordPress pseudo-singleton pattern uses $instance (not $_instance). -->
	<rule ref="PSR2.Classes.PropertyDeclaration">
		<exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
	</rule>

	<!--
		The processor class extends FluentFormPro\Payments\PaymentMethods\BaseProcessor
		and overrides its methods. BaseProcessor's public method signatures use
		camelCase parameter names (e.g. handlePaymentAction($submissionId,
		$submissionData, $form, $methodSettings, $hasSubscriptions, $totalPayable))
		that the parent class calls us with, and Fluent Forms Pro's own
		callback-style invocations (the action handlers we register on
		fluentform/process_payment_chip and friends) also pass camelCase params.
		We cannot rename these without breaking the contract with BaseProcessor
		and the public FF Pro action signature. The exclude below scopes the
		relaxation to the processor file only.
	-->
	<!--
		Three classes inherit the FF Pro public surface (BasePaymentMethod /
		BaseProcessor) which uses camelCase property names (settingsKey) and
		method-parameter names (handlePaymentAction, getSubmission, etc.).
		We cannot rename these without breaking the contract, so the rule
		is relaxed for these files only.
	-->
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>includes/class-chip-fluent-forms-purchase.php</exclude-pattern>
		<exclude-pattern>includes/admin/class-chip-fluent-forms-handler.php</exclude-pattern>
		<exclude-pattern>includes/admin/class-chip-fluent-forms-webhook-setup.php</exclude-pattern>
	</rule>

	<!--
		The plugin entry-point file (chip-for-fluent-forms.php) and the FF
		Pro handler bootstrap (class-chip-fluent-forms-handler.php) combine
		a class declaration with top-level add_action() / helper function
		bootstraps. PSR1 forbids that, but it's the standard WordPress
		plugin entry-point pattern, so the rule is relaxed for these two
		files only.
	-->
	<rule ref="PSR1.Files.SideEffects">
		<exclude-pattern>./chip-for-fluent-forms.php</exclude-pattern>
		<exclude-pattern>./includes/admin/class-chip-fluent-forms-handler.php</exclude-pattern>
	</rule>
</ruleset>
